<div class="catalog-columns">

    <div class="catalog-columns__left">
        {% for row in rows %}
            {% if loop.index is odd %}
                <div{{ row.attributes }}>
                    {{ row.content }}
                </div>
            {% endif %}
        {% endfor %}
    </div>

    <div class="catalog-columns__right">
        {% for row in rows %}
            {% if loop.index is even %}
                <div{{ row.attributes }}>
                    {{ row.content }}
                </div>
            {% endif %}
        {% endfor %}
    </div>

</div>