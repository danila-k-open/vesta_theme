{#
/**
 * @file
 * Таблица товаров, которые заменяет текущий товар каталога.
 *
 * Переменные:
 * - items: массив замен из CompositionBuilder::buildReplacements().
 * - label: подпись блока, если шаблон выводится не как обычное поле Drupal.
 * - parent: текущий товар.
 * - bundle: тип товара.
 * - view_mode: режим отображения.
 * - template_variant: вручную заданный суффикс шаблона из настроек форматтера.
 */
#}
{{ attach_library('vesta_client_cart/product_modal') }}
{% set advanced_options = {
    'width': 726,
    'dialogClass': 'vesta-product-modal-dialog',
    'title': ''
} %}
{% set modal_attributes = 'class="use-ajax vesta-product-modal-link" data-dialog-type="modal" data-dialog-options="' ~ advanced_options|json_encode|e('html_attr') ~ '"' %}

{% if items %}
    <div class="vesta-replacements-list">
        <label class="vesta-field-label">Заменяет: </label>
        <div class="table-wrapper">
            <table class="vesta-replacements-table">
                <thead>
                <tr>
                    <th>Артикул</th>
                    <th>Наименование</th>
                </tr>
                </thead>
                <tbody>
                {% for item in items %}
                    <tr>
                        <td>
                            {% if item.url %}
                                <a href="{{ item.url }}" {{ modal_attributes|raw }}>{{ item.article ?: item.title }}</a>
                            {% else %}
                                {{ item.article ?: item.title }}
                            {% endif %}
                        </td>
                        <td>{{ item.title }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
