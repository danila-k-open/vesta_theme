<{{ ds_content_wrapper }}{{ attributes.addClass('ds-1col', 'clearfix') }}>

{{ title_suffix.contextual_links }}

{% if content['#entity'].field_title_short.value %}
    {% set title_product = content['#entity'].field_title_short.value %}
{% else %}
    {% set title_product = content['#entity'].title.value %}
{% endif %}

<div class="product-link">
    <a href="{{ url('entity.commerce_product.canonical', {
        'commerce_product': commerce_product.id()
    }) }}">{{ title_product }}</a>
</div>

</{{ ds_content_wrapper }}>


