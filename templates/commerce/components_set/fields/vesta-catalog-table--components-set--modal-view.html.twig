{#
/**
 * @file
 * Таблица состава агрегата, узла или комплекта запчастей.
 *
 * Переменные:
 * - rows: подготовленные строки состава из CompositionBuilder.
 * - parent: текущий товар-родитель.
 */
#}
{{ attach_library('vesta_client_cart/product_modal') }}
{% set advanced_options = {
    'width': 726,
    'dialogClass': 'vesta-product-modal-dialog',
    'title': ''
} %}
{% set modal_attributes = 'class="use-ajax vesta-product-modal-link" data-dialog-type="modal" data-dialog-options="' ~ advanced_options|json_encode|e('html_attr') ~ '"' %}
<div class="vesta-catalog-list">
    <label class="vesta-field-label">Содержит:</label>
    <div class="table-wrapper">
        <table class="vesta-catalog-table" data-vesta-catalog-table>
            <thead>
            <tr>
                <th>Артикул</th>
                <th>Наименование</th>
                <th>Кол-во</th>
                <th>Позиция на схеме</th>
            </tr>
            </thead>
            <tbody>
            {% for row in rows %}
                <tr
                        id="{{ row.anchor ?: 'vesta-row-' ~ row.entity_id }}"
                        data-vesta-row
                        data-entity-id="{{ row.entity_id }}"
                        data-vesta-anchor="{{ row.anchor }}"
                        data-vesta-position="{{ row.position }}"
                        data-type="{{ row.type }}"
                        data-article="{{ row.article }}"
                        data-old-article="{{ row.old_article }}"
                        data-title="{{ row.title }}"
                        data-quantity="{{ row.quantity }}"
                        data-order-key="{{ row.order_key }}"
                >
                    <td>
                        {% if row.url %}
                            <a href="{{ row.url }}" {{ modal_attributes|raw }}>{{ row.article ?: row.title }}</a>
                        {% else %}
                            {{ row.article ?: row.title }}
                        {% endif %}
                    </td>
                    <td>{{ row.title }}</td>
                    <td>{{ row.quantity }}</td>
                    <td>{{ row.position }}</td>
                </tr>
            {% else %}
                <tr><td colspan="7">Состав не заполнен.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
