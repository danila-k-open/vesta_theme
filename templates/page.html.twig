{% if page_is_front == true %}
    {% set page_front_class = "front" %}
{% else %}
    {% set page_front_class = "not-front" %}
{% endif %}

{%
    set classes = [
    'page',
    page_front_class,
] | merge(page_class)
%}

<div id="page" {{ attributes.addClass(classes) }}>

    <header id="header" class="header">
        <div class="container">
            {% if page.header %}
                <div class="header">
                    {{ page.header }}
                </div>
            {% endif %}
            {% if page.navigation %}
                <div class="navigation">
                    {{ page.navigation }}
                </div>
            {% endif %}
        </div>
        <div class="header-mobile">
            <div class="container">
                {{ page.header_mobile }}
            </div>
        </div>
    </header>

    {% if page.banner %}
        <div id="banner-block" class="banner-block">
            <div class="container">
                {{ page.banner }}
            </div>
        </div>
    {% endif %}

    <main class="main">
        <a id="main-content" tabindex="-1"></a>
        <div class="container">
            {{ page.content }}
        </div>
    </main>

    {% if page.catalog %}
        <div id="catalog-block" class="catalog-block">
            <div class="container">
                {{ page.catalog }}
            </div>
        </div>
    {% endif %}

    {% if page.form %}
        <div id="form-block" class="form-block">
            <div class="container">
                {{ page.form }}
            </div>
        </div>
    {% endif %}


    <footer id="footer" class="footer">
        <div class="container">
            <div class="footer-block">
                {{ page.footer }}
            </div>
            <div class="copyright-block">
                {{ page.copyright }}
            </div>
        </div>
    </footer>
</div>

{% if page.navigation_mobile %}
    <nav id="mobile-nav">
        {{ page.navigation_mobile }}
    </nav>
{% endif %}
